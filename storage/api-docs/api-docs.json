{
    "openapi": "3.0.0",
    "info": {
        "title": "API Barbearia",
        "description": "API para gerenciamento de uma barbearia",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Registra um novo usuário no sistema",
                "operationId": "d764dd091cc4494ae0baf360b03319f3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "phone",
                                    "cep"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Kelvin"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "kelvin.pereira1904@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "S3nh4!um23"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "format": "phone",
                                        "example": "12999999999"
                                    },
                                    "cep": {
                                        "type": "string",
                                        "example": "11111111"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Verifique seu email"
                    },
                    "502": {
                        "description": "Serviço de procura de cep indisponível"
                    },
                    "422": {
                        "description": "Cep não encontrado"
                    },
                    "500": {
                        "description": "Erro ao cadastrar usuário"
                    }
                }
            }
        },
        "/api/auth/email/verify/{id}/{hash}": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Verifica o email de um usuário e o libera para utilizar o sistema",
                "operationId": "3f036b6fdf75ec4a1a28e716b5db2fd8",
                "responses": {
                    "200": {
                        "description": "Email verificado com sucesso"
                    },
                    "400": {
                        "description": "Hash de verificação de email inválido"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Verifica email e senha enviados pelo usuário e retorna um bearer token",
                "operationId": "8dcb70df1020986038d098cc08d05dae",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "kelvin.pereira1904@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "S3nh4!um23"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token: {bearer token}"
                    },
                    "400": {
                        "description": "Email e/ou senha inválidos"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Invalida e deleta o bearer token e remove a autenticação do usuário",
                "operationId": "69281b12abb272c76871f19cb17ca563",
                "responses": {
                    "200": {
                        "description": "Token deletado"
                    },
                    "400": {
                        "description": "Falha ao deletar token"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Autenticação",
            "description": "Autenticação"
        }
    ]
}